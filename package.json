{
  "name": "cozyclay",
  "version": "3.2.1",
  "description": "Open source previs software in the browser: block a scene, pose characters, author camera moves and cuts, then take the same shots to an AI video model.",
  "scripts": {
    "dev": "node tools/dev-full.mjs --host 127.0.0.1 --port 5180",
    "dev:ui": "vite",
    "build": "vite build && node tools/sitemap.mjs",
    "lint": "node tools/check-knip.mjs && node tools/check-loc.mjs && node tools/check-eslint.mjs",
    "lint:update": "node tools/check-knip.mjs --update && node tools/check-loc.mjs --update && node tools/check-eslint.mjs --update",
    "test": "npm run build && node tools/run-tests.mjs",
    "test:manifest": "node tools/run-tests.mjs --list",
    "test:analytics": "node test/verify-analytics.mjs",
    "test:lifecycle": "npm run build && node test/process/verify-lifecycle.mjs",
    "test:mcp-package": "node test/process/verify-mcp-package-isolation.mjs",
    "test:hierarchy": "node test/verify-hierarchy.mjs",
    "test:history": "node test/verify-history.mjs",
    "test:scene-objects": "node test/verify-scene-objects.mjs",
    "test:scene-assets": "node test/verify-scene-assets.mjs",
    "test:scene-mesh": "node test/verify-scene-mesh.mjs",
    "test:mesh-browser": "node tools/qa-browser.mjs -- node test/verify-mesh-browser.mjs",
    "test:asset-shelf": "node test/verify-asset-shelf.mjs",
    "test:matte": "node test/verify-matte.mjs",
    "test:matte-editor": "node test/verify-matte-editor.mjs",
    "test:scenes": "node test/verify-scenes.mjs",
    "test:camera-move": "node test/verify-camera-move.mjs",
    "test:cuts": "node test/verify-cuts.mjs",
    "test:project-menu": "node tools/qa-browser.mjs -- node test/verify-project-menu-browser.mjs",
    "test:first-success-guide": "QA_STARTUP_CHOOSER=1 node tools/qa-browser.mjs -- node test/verify-first-success-guide-browser.mjs",
    "test:objects": "node tools/qa-browser.mjs -- node test/verify-object-gizmo.mjs",
    "test:theme": "node test/verify-theme.mjs",
    "test:appearance": "node test/verify-appearance.mjs",
    "test:auto-color": "node test/verify-auto-color.mjs",
    "test:shot-guides": "node test/verify-shot-guides.mjs",
    "test:layout": "node test/verify-layout.mjs",
    "test:timeline-camera": "node test/verify-timeline-camera.mjs",
    "test:timeline-shots": "node test/verify-timeline-shots.mjs",
    "preview": "vite preview",
    "test:ardy": "node tools/run-tests.mjs --scope ardy",
    "test:ik-browser": "node tools/qa-browser.mjs -- node test/verify-ik-browser.mjs",
    "demo:api": "npm --prefix workers/api run dev",
    "demo:api:install": "npm --prefix workers/api ci",
    "qa:browser": "node tools/qa-browser.mjs --",
    "tutorial:record": "node tools/tutorial/launch.mjs",
    "test:shot-authoring": "node test/verify-shot-authoring.mjs",
    "test:camera-follow": "node test/verify-camera-follow.mjs",
    "test:sample-at": "node test/verify-sample-at.mjs",
    "test:offscreen-export": "node test/verify-offscreen-export.mjs",
    "test:offscreen-export-browser": "node tools/qa-browser.mjs -- node test/verify-offscreen-export-browser.mjs",
    "test:otio": "node test/verify-otio.mjs",
    "test:usd-camera": "node test/verify-usd-camera.mjs",
    "test:camera-rail-browser": "node tools/qa-browser.mjs -- node test/verify-camera-rail-browser.mjs",
    "test:blocking-depth": "node test/verify-blocking-depth.mjs",
    "test:pwa": "node test/verify-pwa.mjs",
    "test:update-check": "node test/verify-update-check.mjs",
    "test:korean-ui": "node test/verify-korean-ui.mjs",
    "prepack": "npm run build && node tools/prepare-package.mjs",
    "postpack": "node tools/prepare-package.mjs --clean",
    "prepublishOnly": "npm run build && node tools/prepare-package.mjs --check-key && node tools/prepare-package.mjs && node tools/verify-package-tarball.mjs",
    "metrics:snapshot": "node tools/metrics-snapshot.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.306",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-codemode": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jpeg-js": "0.4.4",
    "knip": "^6.41.0",
    "mediabunny": "^1.55.2",
    "posthog-js": "^1.418.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "reactflow": "^11.11.4",
    "three": "^0.187.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16",
    "vite": "^8.2.0"
  },
  "bin": {
    "cozyclay": "bin/cozyclay.mjs",
    "cclay": "bin/cozyclay.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/media/*.mp4",
    "src",
    "tools",
    "!tools/qa-*.mjs",
    "mcp/server.mjs",
    "mcp/tool-handlers.mjs",
    "mcp/live-hub.mjs",
    "mcp/mesh-file.mjs",
    "mcp/image-file.mjs",
    "mcp/project-camera.mjs",
    "mcp/runtime",
    "mcp/package.json",
    "mcp/README.md",
    "mcp/LIVE-PROTOCOL.md",
    "README.md",
    "INSTALL_FOR_AGENTS.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "LICENSING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./mcp/*": "./mcp/*"
  },
  "peerDependencies": {
    "three": ">=0.180"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "3d",
    "previs",
    "animation",
    "blocking",
    "threejs",
    "react-three-fiber",
    "webgl",
    "motion",
    "ardy",
    "storyboard",
    "previz"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NomaDamas/CozyClay.git"
  },
  "homepage": "https://cozyclay.org/",
  "bugs": {
    "url": "https://github.com/NomaDamas/CozyClay/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
